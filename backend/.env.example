# Copie ce fichier en .env (local) et renseigne les mêmes variables dans Vercel
# (Project > Settings > Environment Variables). NE JAMAIS committer les vraies clés.

# --- Base de données : Supabase (obligatoire) ---
# Supabase > Connect > "Transaction pooler" (port 6543), compatible serverless/Vercel.
# Les tables sont créées automatiquement au premier accès (voir supabase/schema.sql).
DATABASE_URL=postgresql://postgres.<project-ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Taille du pool de connexions par instance (garde une petite valeur sur Vercel).
DB_POOL_MAX=4

# --- Application ---
# production : cookies sécurisés + URLs HTTPS obligatoires.
BOOKJOB_ENV=development
# URL publique de l'app (ex. https://bookjob.vercel.app), utilisée dans les e-mails de confirmation.
BOOKJOB_PUBLIC_URL=http://localhost:8000
# Facultatif : impose cette clé pour les inscriptions après la création du premier compte.
BOOKJOB_REGISTRATION_KEY=
# Secret du cron Vercel /api/cron/email-sync (Vercel l'envoie dans l'en-tête Authorization).
CRON_SECRET=

# --- IA : Groq (optionnelle) --- https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google (optionnel) ---
# Clé restreinte : géocodage précis + collecte Places API (python -m app.pipeline.run --source places).
GOOGLE_API_KEY=
# OAuth (application Web) : Gmail (envoi après confirmation, lecture des réponses) et « Continuer avec Google ».
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Doit correspondre exactement à l'URI autorisée dans Google Cloud,
# ex. https://bookjob.vercel.app/api/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
