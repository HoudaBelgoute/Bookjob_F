# Copie ce fichier en .env (local) et renseigne les mêmes variables dans Vercel
# (Project > Settings > Environment Variables). NE JAMAIS committer les vraies clés.

# --- Base de données : Supabase (obligatoire) ---
# Supabase > Connect > "Transaction pooler" (port 6543), compatible serverless/Vercel.
# Vérifier que DATABASE_URL utilise ce host/port et inclut sslmode=require.
# Les tables sont créées automatiquement au premier accès (voir supabase/schema.sql).
DATABASE_URL=
# Taille du pool par instance Vercel. Min 0 = aucune connexion préchauffée.
DB_POOL_MIN=0
DB_POOL_MAX=1
# Attente maximale d'une connexion disponible (secondes).
DB_POOL_TIMEOUT=10

# --- Application ---
# production : cookies sécurisés + URLs HTTPS obligatoires.
BOOKJOB_ENV=development
# URL publique de l'app (ex. https://bookjob.vercel.app), utilisée pour les anciennes confirmations en attente.
BOOKJOB_PUBLIC_URL=http://localhost:8000
# Secret du cron Vercel /api/cron/email-sync (Vercel l'envoie dans l'en-tête Authorization).
CRON_SECRET=

# --- IA : clés serveur de secours (facultatives) ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Clé Fernet dédiée au chiffrement de toutes les clés API personnelles par compte.
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Configurer uniquement côté serveur. L'ancien nom BOOKJOB_AI_KEY_ENCRYPTION_KEY reste accepté et prioritaire.
BOOKJOB_API_KEY_ENCRYPTION_KEY=

# --- Sources de données (facultatives) ---
# Clé API Jooble (https://jooble.org/api/about).
JOOBLE_API_KEY=
# Clé Google Maps Platform avec Places API (New) activée et facturation configurée.
# Sert aussi au géocodage précis et au pipeline Places serveur.
GOOGLE_API_KEY=
# OAuth (application Web) : Gmail (envoi direct, lecture des réponses) et « Continuer avec Google ».
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Doit correspondre exactement à l'URI autorisée dans Google Cloud,
# ex. https://bookjob.vercel.app/api/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
