# Copiez ce fichier en .env (ou définissez ces variables) — NE JAMAIS committer les vraies clés.
# IA unique : Groq (optionnelle).
# Groq API : crée une clé sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Clé Google (optionnelle, restreinte à ce serveur) : géocodage précis des entreprises
# et collecte Places API (New) via `python -m app.pipeline.run --source places`.
GOOGLE_API_KEY=
# Authentification multi-utilisateur. Les mots de passe sont hachés en base SQLite.
BOOKJOB_ENV=development
# Par défaut : backend/data/auth.sqlite3. Utilise un volume privé et persistant en production.
# BOOKJOB_AUTH_DB=
# Facultatif : impose cette clé pour les inscriptions après la création du premier compte.
BOOKJOB_REGISTRATION_KEY=
# Gmail par OAuth : envoi après confirmation explicite et lecture seule pour détecter les réponses.
# Le même client sert aussi au bouton « Continuer avec Google » (scopes openid email profile uniquement).
# Crée un client OAuth de type application Web dans Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Doit correspondre exactement à l'URI de redirection autorisée dans Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/google/callback
# Jeton OAuth privé : par défaut dans le profil local, hors du dossier du projet.
# Sur un hébergeur, définis GOOGLE_TOKEN_FILE sur un volume persistant privé.
# GOOGLE_TOKEN_FILE=
# URL publique du backend, utilisée pour le bouton de confirmation dans l'e-mail reçu.
BOOKJOB_PUBLIC_URL=http://localhost:8000
# Sur un hébergeur, mets EMAIL_CONFIRMATIONS_FILE sur un volume privé et persistant.
# EMAIL_CONFIRMATIONS_FILE=
